# ==== Configuração da aplicação ====
PORT=3000
NODE_ENV=development

# ==== Banco de dados ====
# DATABASE_URL: string de conexão do PostgreSQL.
#
# Postgres local via docker-compose.yml (usuário/senha/db padrão deste repo):
#   postgres://rotina:rotina@localhost:5432/rotina_tdah
#
# Postgres gerenciado Neon (fallback sem Docker) — note o sslmode=require:
#   postgres://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgres://rotina:rotina@localhost:5432/rotina_tdah

# Variáveis do container do docker-compose (usadas só pelo Compose, não pela API)
POSTGRES_USER=rotina
POSTGRES_PASSWORD=rotina
POSTGRES_DB=rotina_tdah

# Ativa SSL no pool pg (obrigatório para Neon e a maioria dos Postgres gerenciados).
# Deixe vazio/false para o Postgres local do Docker.
DB_SSL=false

# ==== Segredos de autenticação (Fase 1 — OBRIGATÓRIOS) ====
# JWT_SECRET assina o access token; JWT_REFRESH_SECRET reservado para uso do refresh.
# Ambos exigem no mínimo 16 caracteres. Gere segredos fortes e ÚNICOS assim:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NUNCA reutilize os placeholders abaixo em produção.
JWT_SECRET=troque-este-segredo-em-producao-min-16-chars
JWT_REFRESH_SECRET=troque-este-outro-segredo-em-producao-min-16-chars

# TTL do access token (formato do jsonwebtoken, ex: 15m, 1h) e dias do refresh.
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ==== CORS (OPCIONAL, mas RECOMENDADO em produção) ====
# Origens do cliente autorizadas a chamar a API, separadas por vírgula.
# Vazio/ausente → CORS permissivo (reflete qualquer origem) — conveniente em dev.
# Em produção, liste a(s) origem(ns) do seu app para travar quem pode chamar a API:
#   CORS_ORIGIN=https://meu-app.com,https://www.meu-app.com
CORS_ORIGIN=

# ==== Google OAuth (OPCIONAL) ====
# Se ausente, POST /auth/google responde 501 sem quebrar o boot.
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
