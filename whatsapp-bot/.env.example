# URL base da API Rotina TDAH
API_BASE=https://rotina-tdah-api.onrender.com

# Credenciais da conta pessoal do usuário no app
BOT_EMAIL=seu-email@exemplo.com
BOT_PASSWORD=sua-senha

# JID de destino no WhatsApp (opcional — padrão: envia para si mesmo)
# Se não for definido, o bot envia a mensagem para o próprio número
# Para grupos: NÚMERO-GRUPO@g.us
# Para contato: NÚMERO@s.whatsapp.net (com código do país, sem +)
WHATSAPP_TARGET_JID=
